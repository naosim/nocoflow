digraph g {
graph [
rankdir = "TD"
];
node [shape=record, sizefixed=true,fontname="ＭＳＰ ゴシック", width=3]
edge [minlen=2];

title [
		fontsize = 40,
		label = "UI Flows",
		shape = plain,
		style = ""]

"context-list" [
label = "{
<t>コンテキスト一覧 
| コンテキストの一覧 
| <f1>コンテキストを選択する 
| <f2>コンテキストを作成する 
| <f3>フロー詳細へ
}"
shape = "record"
];

"context-detail" [
label = "{
<t>コンテキスト詳細
| コンテキストの詳細情報
| <f1> フローを作成する
}"
shape = "record"
];

"context-create" [
label = "{
<t>コンテキスト作成
| <f1>コンテキストを作成する(submit)
}"
shape = "record"
];

"flow-list" [
label = "{
<t>フロー一覧 
| フローの一覧 
| <f1>フローを選択する
| <f2>フローを作成する 
}"
shape = "record"
];

"flow-create" [
label = "{
<t>フロー作成
|<f1>フローを作成する(submit)
}"
shape = "record"
];

"flow-detail" [
label = "{
<t>フロー詳細
|<f1> フロー一覧へ
}"
shape = "record"
];

"menu" [
label="{メニュー(共通ヘッダ)}"
];
"menu" -> "context-list":t;
"menu" -> "flow-list":t;

"context-list":f1 -> "context-detail":t;
"context-list":f2 -> "context-create":t;
"context-list":f3 -> "flow-detail":t;

"context-detail":f1 -> "flow-create";

"context-create":f1 -> "context-detail":t;

"flow-list":f1 -> "flow-detail":t;
"flow-list":f2 -> "flow-create":t;

"flow-create":f1 -> "flow-detail":t

"flow-detail":f1 -> "flow-list":t;


}